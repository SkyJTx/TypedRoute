{
    "name":  "@skyjt/typed-routes",
    "version":  "0.1.0",
    "description":  "Framework-agnostic compile-time typed routes, schema validation, URL builder, and API middleware for filesystem-routing",
    "type":  "module",
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE",
                  "CHANGELOG.md"
              ],
    "sideEffects":  false,
    "main":  "./dist/index.js",
    "module":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          },
                    "./vite":  {
                                   "types":  "./dist/vite/index.d.ts",
                                   "import":  "./dist/vite/index.js"
                               },
                    "./package.json":  "./package.json"
                },
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsup",
                    "test":  "vitest run",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "oxlint src",
                    "clean":  "node -e \"import(\u0027node:fs\u0027).then(fs =\u003e fs.rmSync(\u0027dist\u0027, { recursive: true, force: true }))\"",
                    "prepublishOnly":  "bun run build"
                },
    "license":  "AGPL-3.0-or-later",
    "peerDependencies":  {
                             "filesystem-routing":  "^0.2.1",
                             "vite":  "\u003e=5.0.0"
                         },
    "peerDependenciesMeta":  {
                                 "vite":  {
                                              "optional":  true
                                          }
                             },
    "devDependencies":  {
                            "@types/node":  "^22.20.3",
                            "filesystem-routing":  "0.2.1",
                            "oxlint":  "~1.79.0",
                            "tsup":  "^8.5.0",
                            "typescript":  "^5.9.3",
                            "valibot":  "^1.5.0",
                            "vite":  "^8.3.0",
                            "vitest":  "^5.0.1",
                            "zod":  "^3.25.76"
                        }
}