{
  "name": "@skyjt/typed-routes",
  "version": "0.6.0",
  "description": "Framework-agnostic compile-time typed routes, schema validation, URL builder, and API middleware for filesystem-routing",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "prepublishOnly": "bun run build"
  },
  "license": "MPL-2.0",
  "peerDependencies": {
    "filesystem-routing": "^0.4.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "filesystem-routing": "^0.4.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.7"
  }
}
