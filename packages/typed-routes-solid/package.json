{
  "name": "@skyjt/typed-routes-solid",
  "version": "0.1.3",
  "description": "SolidJS and @solidjs/router adapter for @skyjt/typed-routes",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "prepublishOnly": "bun run build"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@skyjt/typed-routes": "workspace:^"
  },
  "peerDependencies": {
    "@skyjt/typed-routes": "^0.2.0",
    "@solidjs/router": "^2.0.0-next.21 || ^2.0.0-next.23 || ^2.0.0-next.24",
    "@solidjs/web": "^2.0.0-rc.6 || ^2.0.0-rc.7 || ^2.0.0-rc.8",
    "filesystem-routing": "^0.2.1",
    "solid-js": "^2.0.0-rc.6 || ^2.0.0-rc.7 || ^2.0.0-rc.8",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/router": "^2.0.0-next.24",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.43",
    "@solidjs/web": "^2.0.0-rc.8",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/node": "^22.20.3",
    "filesystem-routing": "0.2.1",
    "jsdom": "^25.0.1",
    "oxlint": "~1.79.0",
    "solid-js": "^2.0.0-rc.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^3.25.76"
  }
}